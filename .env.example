# Root-level .env – consumed by docker-compose.yml
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# JWT secrets must be long, random strings (min 32 chars recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Override CORS allowed origin if needed (default: http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173
